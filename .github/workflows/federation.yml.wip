name: Federation Docker

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
    inputs:
      run_misskey_fixture:
        description: Start ./misskey federation fixture with Rosmarinus overlay
        required: false
        default: "false"
        type: choice
        options:
          - "false"
          - "true"

permissions:
  contents: read

jobs:
  docker-smoke:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod

      - name: Run Go tests
        run: go test ./...

      - name: Build distroless image
        run: docker build -t rosmarinus:test .

      - name: Verify image user is nonroot
        run: test "$(docker image inspect --format '{{.Config.User}}' rosmarinus:test)" = "nonroot:nonroot"

      - name: Start Rosmarinus smoke stack
        run: docker compose -f docker/federation/rosmarinus.compose.yml up -d --wait

      - name: Check Rosmarinus health endpoint
        run: |
          for i in {1..30}; do
            if curl -fsS http://127.0.0.1:8080/healthz; then
              exit 0
            fi
            sleep 2
          done
          docker compose -f docker/federation/rosmarinus.compose.yml logs
          exit 1

      - name: Stop Rosmarinus smoke stack
        if: always()
        run: docker compose -f docker/federation/rosmarinus.compose.yml down -v

  misskey-fixture-shape:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    if: github.event_name == 'workflow_dispatch' && inputs.run_misskey_fixture == 'true'
    steps:
      - uses: actions/checkout@v4

      - name: Require local Misskey checkout
        run: test -f misskey/packages/backend/test-federation/compose.yml

      - name: Build Rosmarinus image
        run: docker build -t rosmarinus:test .

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
          cache-dependency-path: misskey/pnpm-lock.yaml

      - name: Enable pnpm
        working-directory: misskey
        run: |
          corepack enable
          corepack prepare pnpm@latest --activate

      - name: Install and build Misskey
        working-directory: misskey
        run: |
          pnpm install --frozen-lockfile
          pnpm build

      - name: Prepare Misskey federation certificates
        working-directory: misskey/packages/backend/test-federation
        run: |
          bash ./setup.sh
          openssl req -new -newkey rsa:2048 -sha256 -nodes \
            -keyout certificates/rosmarinus.test.key \
            -subj "/CN=rosmarinus.test/emailAddress=admin@rosmarinus.test/C=JP/ST=/L=/O=Rosmarinus Tester/OU=Federation" \
            -out certificates/rosmarinus.test.csr
          openssl x509 -req -sha256 \
            -in certificates/rosmarinus.test.csr \
            -CA certificates/rootCA.crt \
            -CAkey certificates/rootCA.key \
            -CAcreateserial \
            -passin pass:rootCA \
            -out certificates/rosmarinus.test.crt \
            -days 500

      - name: Start Misskey federation fixture with Rosmarinus
        env:
          NODE_VERSION: "22"
          ROSMARINUS_IMAGE: rosmarinus:test
        run: >
          docker compose
          -f misskey/packages/backend/test-federation/compose.yml
          -f misskey/packages/backend/test-federation/compose.override.yaml
          -f docker/federation/misskey-rosmarinus.compose.yml
          up -d --wait --scale tester=0

      - name: Smoke Rosmarinus through Misskey federation network
        env:
          NODE_VERSION: "22"
        run: >
          docker compose
          -f misskey/packages/backend/test-federation/compose.yml
          -f misskey/packages/backend/test-federation/compose.override.yaml
          -f docker/federation/misskey-rosmarinus.compose.yml
          run --rm --no-deps tester
          node -e "const u='https://rosmarinus.test/.well-known/webfinger?resource=acct:relay@rosmarinus.test'; fetch(u).then(async r=>{ console.log(r.status, await r.text()); if (!r.ok) process.exit(1); }).catch(e=>{ console.error(e); process.exit(1); })"

      - name: Stop Misskey federation fixture
        if: always()
        env:
          NODE_VERSION: "22"
        run: >
          docker compose
          -f misskey/packages/backend/test-federation/compose.yml
          -f misskey/packages/backend/test-federation/compose.override.yaml
          -f docker/federation/misskey-rosmarinus.compose.yml
          down -v
